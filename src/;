

#include "sim.hpp"
#include "parser.hpp"
#include "missile.hpp"

#include <iostream>

#define LOG "log/log.csv"

namespace sim {
    misl::Missile missile(const Conditions& c) {
        std::ofstream out(LOG); // file used to log data
        if (!out) {
            return;
        }

        misl::Missile m = c.m;
        
        for (float t = 0; t < c.end; t += c.dt) {
            log_missile(out, t, m)
            update_state(m, {0.f, 0.f, 0.f}, {0.f, 0.f, 0.f}, c.dt);

        }
        log_missile(out, c.end, m);

        out.close();

        return m;
    }

    void log_missile(std::ofstream &out, float t, const Missile &m) {
        out << t << ", "
            << m.position[0] << ", "
            << m.position[1] << ", "
            << m.position[2];

        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 3; j++) {
                out << ", " << m.rotation[j][i];
        
            }
        }
        out << std::endl;
    }
}
